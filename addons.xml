            <import addon="kodi.binary.global.main" version="1.0.0"/>
            <import addon="kodi.binary.instance.pvr" version="5.10.0"/>
        </requires>
        <extension point="xbmc.pvrclient" library_android="libpvr.jellyfin.so" library_linux="libpvr.jellyfin.so" library_windows="pvr.jellyfin.dll" library_osx="libpvr.jellyfin.dylib"/>
